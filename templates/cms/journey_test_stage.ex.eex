defmodule <%= @test_namespace %>.JourneyTestStage do
  @moduledoc """
  Names the journey stage that failed under LiveView or Playwright.

  While a demo is being recorded (`CMS_JOURNEY_VIDEO_DIR` set, Playwright
  session), each stage also shows a caption bar with its name (and, given
  `done_when:`, its done-when) and pauses `CMS_JOURNEY_PACE_MS` (default 1500)
  so the recording is watchable. Otherwise it is a no-op and the gate stays fast.
  """

  # Resolves once the page's LiveView root has joined (or there is none), within 10s.
  @await_connected_js """
  new Promise((resolve) => {
    const started = Date.now();
    const tick = () => {
      const root = document.querySelector("[data-phx-main]") || document.querySelector("[data-phx-session]");
      if (!root || root.classList.contains("phx-connected") || Date.now() - started > 10000) return resolve(true);
      setTimeout(tick, 50);
    };
    tick();
  })
  """

  @doc """
  Waits until the page's LiveView has joined; any session but a Playwright one
  comes back as it was.

  `stage/4` waits only before its action, so an action that `visit/2`s and then
  interacts needs this after the visit: `visit/2` resolves on page load, before
  the socket joins, and a `select/3` or click sent in that gap is dropped.
  """
  def connected(%{__struct__: PhoenixTest.Playwright} = session),
    do: PhoenixTest.Playwright.evaluate(session, @await_connected_js)

  def connected(session), do: session

  @doc """
  Shows a caption mid-stage, without ending it, then pauses -- the same gate
  as `stage/4` itself (a no-op unless a demo is recording). A stage whose
  body does several distinct things (build a batch, then offer it; four
  separate reproduction attempts) otherwise shows nothing between its own
  caption and the next stage's, and everything in between vanishes into a
  blink: "the video goes way too fast".

  Takes the pipeline's own accumulator (what `stage/4`'s action threads
  through), not a bare session -- looks for its `:session` key.
  """
  def checkpoint(%PhoenixTest.Playwright{} = session, text) do
    case System.get_env("CMS_JOURNEY_VIDEO_DIR") do
      dir when dir in [nil, ""] ->
        session

      _ ->
        PhoenixTest.Playwright.evaluate(session, caption_js(text))
        Process.sleep(pace_ms())
        session
    end
  end

  def checkpoint(%{session: %PhoenixTest.Playwright{}} = state, text) do
    checkpoint(state.session, text)
    state
  end

  def checkpoint(value, _text), do: value

  @doc "`PhoenixTest.visit/2`, then `connected/1`: the visit a stage's action should use."
  def visit(session, path),
    do: session |> PhoenixTest.visit(path) |> assets_built() |> connected()

  # A LiveView page whose app.js never loaded has no socket, so every click is
  # dropped and the stage fails on a missing element, which reads as a walk bug.
  @assets_built_js "!document.querySelector('[data-phx-main],[data-phx-session]') || !!window.liveSocket"

  defp assets_built(%{__struct__: PhoenixTest.Playwright} = session) do
    PhoenixTest.Playwright.evaluate(session, @assets_built_js, fn
      true -> :ok
      _missing -> raise "assets not built: run MIX_ENV=test mix assets.build"
    end)
  end

  defp assets_built(session), do: session

  def stage(session, name, action, opts \\ []) when is_function(action, 1) do
    session |> announce(name, opts) |> action.()
  rescue
    error ->
      reraise ExUnit.AssertionError,
              [message: "Journey stage #{inspect(name)} failed: #{Exception.message(error)}"],
              __STACKTRACE__
  end

  defp announce(%{__struct__: PhoenixTest.Playwright} = session, name, opts) do
    # A click sent before the LiveView socket joins never reaches the server: the
    # stage failed at random (pass/fail/pass/fail on unchanged code, e424b6e5).
    session = connected(session)

    case System.get_env("CMS_JOURNEY_VIDEO_DIR") do
      dir when dir in [nil, ""] ->
        session

      _ ->
        text = caption(name, opts[:done_when])
        session = PhoenixTest.Playwright.evaluate(session, caption_js(text))
        Process.sleep(pace_ms())
        session
    end
  end

  defp announce(session, _name, _opts), do: session

  defp caption(name, nil), do: name
  defp caption(name, done_when), do: "#{name} \u2014 done when: #{done_when}"

  defp pace_ms, do: String.to_integer(System.get_env("CMS_JOURNEY_PACE_MS") || "1500")

  defp caption_js(text) do
    escaped = text |> String.replace("\\", "\\\\") |> String.replace("\"", "\\\"")

    """
    (() => {
      let el = document.getElementById("journey-caption");
      if (!el) {
        el = document.createElement("div");
        el.id = "journey-caption";
        el.style.cssText = "position:fixed;left:0;right:0;bottom:0;z-index:99999;padding:14px 24px;background:#111827;color:#fff;font:600 18px system-ui;text-align:center";
        document.body.appendChild(el);
      }
      el.textContent = "#{escaped}";
    })()
    """
  end
end
