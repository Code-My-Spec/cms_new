# Where kamal looks up the secrets its config names.
#
# `config/deploy*.yml` says `password: - KAMAL_REGISTRY_PASSWORD`; that is a
# lookup into this file, not a read of the environment. Without the file kamal
# refuses before it does anything:
#
#   ERROR (Kamal::ConfigurationError): Secret 'KAMAL_REGISTRY_PASSWORD' not
#   found, no secret files (.kamal/secrets-common, .kamal/secrets) provided
#
# `$VAR` pulls from the environment, which is how both a person and the setup
# routine supply them: a person exports them or lets `bin/deploy` read the age
# key off disk, and setup passes them to the script directly.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SOPS_AGE_KEY=$SOPS_AGE_KEY
