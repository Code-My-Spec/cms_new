import Config

# config/runtime.exs is executed for all environments, including
# during releases. It is executed after compilation and before the
# system starts, so it is typically used to load production configuration
# and secrets from environment variables or elsewhere. Do not define
# any compile-time configuration in here, as it won't be applied.
# The block below contains prod specific runtime configuration.

# The port, for every environment — deliberately outside the `:prod` guard
# below. A workspace container is handed its port through the environment and
# has no opportunity to edit config, so this has to be the one place that
# decides it.
#
# The consequence is worth stating where somebody will hit it: setting a port in
# `config/dev.exs` does nothing, because this runs afterwards and overrides it.
# The symptom is `:eaddrinuse` on 4000 — a port you did not configure and cannot
# find in dev.exs — and the fix is `PORT=4321 mix phx.server` rather than a
# config change.
config :<%= @web_app_name %>, <%= @endpoint_module %>,
  http: [port: String.to_integer(System.get_env("PORT", "4000"))]

if config_env() == :prod do
  config :<%= @app_name %>, :dns_cluster_query, System.get_env("DNS_CLUSTER_QUERY")
end
