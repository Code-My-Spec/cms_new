# What every provision step reads. A step is run as `just provision <step> <dir>`
# with PROVISION_TARGET set to the target whose step list names it.
ENV_NAME=${PROVISION_TARGET:-uat}
APP=<%= @app_name %>
# The box this target runs on and the registry on it. Fill these in once.
BOX_IP=
REGISTRY=
ARCH=arm64
[ -n "$BOX_IP" ] && [ -n "$REGISTRY" ] || { echo "provision: set BOX_IP and REGISTRY in provision/env.sh"; exit 1; }
BOX=root@$BOX_IP
HOST=<%= String.replace(@app_name, "_", "-") %>.$(echo "$BOX_IP" | tr . -).sslip.io
IMAGE=$REGISTRY/<%= String.replace(@app_name, "_", "-") %>
REGISTRY_USER=cms_$APP
DB=app_${APP}_$ENV_NAME
ENC=envs/$ENV_NAME.enc.env
KEY=$HOME/.config/sops/age/$APP-$ENV_NAME.key
export SOPS_AGE_KEY_FILE=$KEY
